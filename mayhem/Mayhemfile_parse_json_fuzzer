# Fuzzes SPDK's parse_json_fuzzer (see mayhem/harnesses/parse_json_fuzzer.c) as an in-process libFuzzer target.
project: savantenvs/spdk
target: parse_json_fuzzer
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/parse_json_fuzzer/testsuite
cmds:
  - cmd: /mayhem/parse_json_fuzzer
    libfuzzer: true
    timeout: 10
